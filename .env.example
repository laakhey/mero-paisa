# Cloud sync (optional). Copy this file to `.env` and fill in both values from
# Supabase → Project Settings → API keys. See docs/SYNC_SETUP.md.
#
# Both are safe to ship in the app: the publishable key only allows what the
# row-level security policies permit. NEVER put a Supabase *secret* key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
